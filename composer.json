{
    "name": "phlib/csv",
    "description": "A CSV parsing library; Prevents out of memory errors when parsing large files without a closing string delimiter",
    "keywords": ["csv"],
    "license": "LGPL-3.0",
    "require": {
        "php": "^8.1",
        "psr/http-message": "^2",
        "guzzlehttp/psr7": "^2"
    },
    "suggest": {
        "ext-zip": "Required to open CSV files from Zip archives"
    },
    "require-dev": {
        "ext-zip": "*",
        "phpunit/phpunit": "^9",
        "symplify/easy-coding-standard": "^13"
    },
    "autoload": {
        "psr-4": {
            "Phlib\\Csv\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phlib\\Csv\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "check-cs": "vendor/bin/ecs check --ansi",
        "fix-cs": "vendor/bin/ecs check --fix --ansi"
    }
}
